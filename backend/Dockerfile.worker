FROM python:3.12-slim

WORKDIR /app

# System dependencies for Playwright + Chrome
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers (Chromium only — smaller image)
RUN playwright install chromium
RUN playwright install-deps chromium

# Application code
COPY . .

# Persistent browser profile volume mount point
RUN mkdir -p /data/browser-profiles
VOLUME ["/data/browser-profiles"]

# Restate worker port
EXPOSE 9080

# Environment variables for browser profile persistence
ENV BROWSER_PROFILE_DIR=/data/browser-profiles
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Run both the worker HTTP server and Restate handler
CMD ["bash", "start_worker.sh"]
