# ── Mongo / Cosmos DB ──
MONGO_URI=mongodb://...?tls=true&tlsAllowInvalidCertificates=true
MONGO_DB=workflowdb
MONGO_COLLECTION=auth-submissions

# ── Azure Blob Storage ──
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=carelon-attachments

# ── Azure AI Document Intelligence (OCR for clinical PDFs) ──
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://ronexa-doc-intel.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=

# ── LLM API Keys ──
# Gemini Pro — primary for pathway Q&A + extraction interpretation
GOOGLE_API_KEY=AI...
# Anthropic — fallback
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — RAG embeddings only
OPENAI_API_KEY=sk-...

# ── Carelon Portal Accounts ──
# Worker 1 — Day shift account
CARELON_USERNAME_1=user1@envision.com
CARELON_PASSWORD_1=
MFA_MAILBOX_1=carelon-mfa-1@envision.com

# Worker 2 — Night shift account
CARELON_USERNAME_2=user2@envision.com
CARELON_PASSWORD_2=
MFA_MAILBOX_2=carelon-mfa-2@envision.com

CARELON_BASE_URL=https://www.providerportal.com

# ── MFA (Microsoft Graph API) ──
MFA_TENANT_ID=
MFA_CLIENT_ID=
MFA_CLIENT_SECRET=
